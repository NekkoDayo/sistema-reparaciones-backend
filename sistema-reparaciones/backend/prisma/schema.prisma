generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Cliente {
  id        Int      @id @default(autoincrement())
  nombre    String
  telefono  String
  correo    String   @unique
  equipos   EquipoReparacion[]
  createdAt DateTime @default(now())
}

model EquipoReparacion {
  id          Int      @id @default(autoincrement())
  tipoEquipo  String
  marca       String
  modelo      String
  falla       String
  estado      String   @default("PENDIENTE")
  clienteId   Int
  cliente     Cliente  @relation(fields: [clienteId], references: [id])
  createdAt   DateTime @default(now())
}

model Usuario {
  id        Int      @id @default(autoincrement())
  nombre    String
  correo    String   @unique
  password  String
  createdAt DateTime @default(now())
}